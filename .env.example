# Copy to .env (already git-ignored) and fill in. Never commit .env.

# MST Blockchain: address of YOUR deployed AgriProvenance contract on MST Testnet (chain ID 91562037).
# A contract address is public (it is visible on MSTScan), so it is safe as a VITE_ variable.
# Do NOT put a private key or Secret Recovery Phrase anywhere in this project. MetaMask signs every transaction.
VITE_AGRI_MST_ADDRESS=

# Server-only (never prefix these with VITE_, or they are shipped to the browser)
MONGODB_URI=
MONGODB_DB_NAME=
